static var _cache: Dictionary = {}


## Loads and caches a Texture2D safely in both exported builds and un-imported editor sessions.
static func get_tex(res_path: String) -> Texture2D:
	if res_path.is_empty():
		return null

	if _cache.has(res_path):
		return _cache[res_path] as Texture2D

	var tex: Texture2D = null

	if ResourceLoader.exists(res_path):
		tex = load(res_path) as Texture2D

	if tex == null and OS.has_feature("editor"):
		var global_path := ProjectSettings.globalize_path(res_path)
		if FileAccess.file_exists(global_path):
			var img := Image.load_from_file(global_path)
			if img and not img.is_empty():
				tex = ImageTexture.create_from_image(img)

	if tex != null:
		_cache[res_path] = tex
	else:
		push_warning("ModelTextures: Could not load texture at '%s'." % res_path)

	return tex


static func clear_cache() -> void:
	_cache.clear()
